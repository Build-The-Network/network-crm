# ─── Gmail (SMTP + App Password) ─────────────────────────────────────────────
# Go to myaccount.google.com → Security → 2-Step Verification → App Passwords
# Create one named "CRM Bot". Paste the 16-char code (spaces OK).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Notion ───────────────────────────────────────────────────────────────────
# Internal integration token from https://www.notion.so/my-integrations
# The integration must be shared with the Contacts database.
NOTION_TOKEN=your_notion_integration_token
# The ID of the Contacts database (from the Notion page URL)
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
# Bot needs "Create Instant Invite" permission in the target channel.
DISCORD_BOT_TOKEN=your_bot_token_here
# The guild/server ID (Developer Mode → right-click server → Copy Server ID)
DISCORD_SERVER_ID=000000000000000000
# The channel ID where new members land (right-click channel → Copy Channel ID)
DISCORD_CHANNEL_ID=000000000000000000

# ─── Server ───────────────────────────────────────────────────────────────────
# Railway injects PORT automatically. Set locally if you want a specific port.
PORT=3000
